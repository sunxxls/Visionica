<?xml version="1.0" encoding="utf-8"?>
<!--
    FIX del InflateException en TextInputLayout:
    ─────────────────────────────────────────────
    La causa más común es que el tema de la Activity (o Application) NO hereda
    de Theme.MaterialComponents.  Soluciones (elige una):

    OPCIÓN A – la más sencilla y recomendada:
      En res/values/themes.xml cambia el padre de tu tema:
        <style name="Theme.TuApp" parent="Theme.MaterialComponents.Light.NoActionBar">

    OPCIÓN B – si quieres seguir con AppCompat:
      Usa un MaterialComponentsViewInflater en tu tema base:
        <item name="viewInflaterClass">
            com.google.android.material.theme.MaterialComponentsViewInflater
        </item>

    OPCIÓN C – envuelve el BottomSheetDialogFragment con un contexto temado:
      En onCreateView usa:  ContextThemeWrapper(context, R.style.Theme.MaterialComponents_Light)

    Este layout usa style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    (Material 3).  Si tu dependencia es Material 2 cambia a:
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
-->

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:background="@drawable/bg_bottom_sheet">

        <!-- ── Handle ── -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_handle"/>

        <!-- ── Encabezado ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/bg_icon_container">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="#8B5394"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nuevo evento"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:letterSpacing="-0.02"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completa los detalles"
                    android:textSize="13sp"
                    android:textColor="#9E9EBA"
                    android:layout_marginTop="1dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ── Sección: Información ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFORMACIÓN"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textColor="#8B5394"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Campo Título -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTitle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Título del evento"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/selector_input_stroke"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="#8B5394"
            app:startIconDrawable="@drawable/ic_title"
            app:startIconTint="#C4A8D4"
            app:boxBackgroundColor="#FAFAFA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="#1A1A2E"
                android:textSize="15sp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Descripción (opcional)"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/selector_input_stroke"
            app:boxStrokeWidth="1.5dp"
            app:hintTextColor="#8B5394"
            app:startIconDrawable="@drawable/ic_description"
            app:startIconTint="#C4A8D4"
            app:boxBackgroundColor="#FAFAFA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minLines="2"
                android:gravity="top"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="#1A1A2E"
                android:textSize="15sp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Sección: Hora ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HORA"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textColor="#8B5394"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/containerTimePicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_time_card">

            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_icon_container">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="#8B5394"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora del evento"
                    android:textSize="12sp"
                    android:textColor="#9E9EBA"/>

                <TextView
                    android:id="@+id/tvSelectedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin definir"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickTime"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Elegir"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#EDE0F5"
                android:textColor="#8B5394"
                app:cornerRadius="18dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

        </LinearLayout>

        <!-- ── Sección: Categoría ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORÍA"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textColor="#8B5394"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <GridLayout
            android:id="@+id/colorSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false"
            android:layout_marginBottom="28dp">

            <!-- Personal -->
            <LinearLayout
                android:id="@+id/chipPersonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_category_selected">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot_personal"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#5C3D6E"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vida cotidiana"
                        android:textSize="11sp"
                        android:textColor="#9E9EBA"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Clases -->
            <LinearLayout
                android:id="@+id/chipClases"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_category_unselected">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot_clases"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clases"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Académico"
                        android:textSize="11sp"
                        android:textColor="#9E9EBA"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Tarea -->
            <LinearLayout
                android:id="@+id/chipTarea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_category_unselected">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot_tarea"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tarea"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entregables"
                        android:textSize="11sp"
                        android:textColor="#9E9EBA"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Urgente -->
            <LinearLayout
                android:id="@+id/chipUrgente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_category_unselected">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_dot_urgente"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Urgente"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alta prioridad"
                        android:textSize="11sp"
                        android:textColor="#9E9EBA"/>
                </LinearLayout>

            </LinearLayout>

        </GridLayout>

        <!-- ── Botón Guardar ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEvent"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Guardar evento"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            app:backgroundTint="#8B5394"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@android:color/white"
            app:iconPadding="8dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>