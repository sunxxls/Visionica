<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_handle"/>

    <!-- Ícono -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_container"/>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            app:tint="#8B5394"/>

    </FrameLayout>

    <!-- Nombre del estudiante -->
    <TextView
        android:id="@+id/tvDialogStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar asistencia"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="4dp"/>

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona el estado manual del estudiante"
        android:textSize="13sp"
        android:textColor="#9E9EBA"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="24dp"/>

    <!-- ── Botones de estado ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Falta -->
        <TextView
            android:id="@+id/btnAbsent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="✕   Marcar Falta"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_status_absent"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Permiso -->
        <TextView
            android:id="@+id/btnPermit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="📌   Marcar Permiso"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#8B5394"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_category_selected"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Licencia -->
        <TextView
            android:id="@+id/btnLicense"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="📄   Marcar Licencia"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:background="@drawable/bg_status_late"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- Divisor -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEE8F4"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>

    <!-- Botón Cancelar -->
    <TextView
        android:id="@+id/btnCancelManual"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Cancelar"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#9E9EBA"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>