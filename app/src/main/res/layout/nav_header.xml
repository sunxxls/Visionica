<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_login_header"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="52dp"
    android:paddingBottom="24dp">

    <!-- Foto de perfil con anillo -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Anillo exterior semitransparente -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_ring"/>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivNavProfile"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:layout_margin="5dp"
            android:src="@drawable/ic_user_placeholder"
            app:civ_border_width="2dp"
            app:civ_border_color="#FFFFFF"/>

    </FrameLayout>

    <!-- Nombre del usuario -->
    <TextView
        android:id="@+id/tvNavName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Usuario"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="-0.01"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Email del usuario -->
    <TextView
        android:id="@+id/tvNavEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="correo@ejemplo.com"
        android:textSize="13sp"
        android:textColor="#D4B8F0"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Badge de rol (opcional — puedes ocultarlo con visibility="gone") -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="Instituto Tecnologico Ayacucho"
        android:textSize="11sp"
        android:textColor="#8B5394"
        android:textStyle="bold"
        android:background="@drawable/bg_role_badge"/>

    <!-- Línea divisoria -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#33FFFFFF"/>

</LinearLayout>