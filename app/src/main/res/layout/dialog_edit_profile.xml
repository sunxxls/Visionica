<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet">

        <!-- ── Handle ── -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_handle"/>

        <!-- ── Header con degradado ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="28dp"
            android:background="@drawable/bg_login_header">

            <!-- Avatar con botón de edición -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_user_placeholder"
                    app:civ_border_width="3dp"
                    app:civ_border_color="#FFFFFF"/>

                <!-- Botón editar -->
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_role_badge"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_edit"
                        app:tint="#8B5394"/>

                </FrameLayout>

            </FrameLayout>

            <!-- Hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Toca la foto para cambiarla"
                android:textSize="12sp"
                android:textColor="#D4B8F0"/>

        </LinearLayout>

        <!-- ── Contenido del formulario ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- ── Sección: Información personal ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#8B5394"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACIÓN PERSONAL"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#8B5394"
                    android:letterSpacing="0.12"/>

            </LinearLayout>

            <!-- Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Nombre visible"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#8B5394"
                app:boxStrokeWidth="1.5dp"
                app:hintTextColor="#8B5394"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="#C4A8D4"
                app:boxBackgroundColor="#FAFAFA">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    android:inputType="textPersonName"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Teléfono -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:hint="Teléfono"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#8B5394"
                app:boxStrokeWidth="1.5dp"
                app:hintTextColor="#8B5394"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="#C4A8D4"
                app:boxBackgroundColor="#FAFAFA">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    android:inputType="phone"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Sección: Institución académica ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#8B5394"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTITUCIÓN ACADÉMICA"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#8B5394"
                    android:letterSpacing="0.12"/>

            </LinearLayout>

            <!-- Institución -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Institución"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#8B5394"
                app:boxStrokeWidth="1.5dp"
                app:hintTextColor="#8B5394"
                app:startIconDrawable="@drawable/ic_school"
                app:startIconTint="#C4A8D4"
                app:boxBackgroundColor="#FAFAFA">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etInstitution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    android:inputType="textCapWords"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Carrera -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:hint="Carrera o área"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#8B5394"
                app:boxStrokeWidth="1.5dp"
                app:hintTextColor="#8B5394"
                app:startIconDrawable="@drawable/ic_description"
                app:startIconTint="#C4A8D4"
                app:boxBackgroundColor="#FAFAFA">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCareer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint=""
                    android:inputType="textCapWords"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>